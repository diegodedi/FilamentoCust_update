{
    "name": "react-example",
    "private": true,
    "version": "1.0.8",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"vite --port=3000 --host=0.0.0.0\" \"npm run printer-bridge\"",
        "build": "vite build",
        "preview": "vite preview",
        "clean": "rm -rf dist server.js",
        "lint": "tsc --noEmit",
        "printer-bridge": "cd printer-bridge && npm start",
        "electron": "cross-env NODE_ENV=development electron .",
        "build:electron": "vite build && electron-builder"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/vite": "^4.1.14",
        "@vitejs/plugin-react": "^5.0.4",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "electron-updater": "^6.8.9",
        "express": "^4.21.2",
        "firebase": "^12.15.0",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "recharts": "^3.9.0",
        "vite": "^6.2.3"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "autoprefixer": "^10.4.21",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "electron": "^44.1.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.25.0",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.3",
        "wait-on": "^9.1.0"
    },
    "main": "printer-bridge/electron.js",
    "build": {
        "appId": "com.filamentocust.app",
        "productName": "Filamento Cust",
        "directories": {
            "output": "dist_app"
        },
        "files": [
            "dist/**/*",
            "printer-bridge/**/*"
        ],
        "win": {
            "target": "nsis"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/diegodedi/FilamentoCust_update.git"
    }
}
